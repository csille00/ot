{
  "manifest_version": 2,
  "name": "Reuse tab",
  "version": "1.0",
  "description": "A link opened from outside the browser switches to the tab that already has it.",
  "browser_specific_settings": { "gecko": { "id": "reuse-tab@otis-rs", "data_collection_permissions": { "required": ["none"] } } },
  "permissions": ["tabs"],
  "background": { "scripts": ["background.js"] }
}
